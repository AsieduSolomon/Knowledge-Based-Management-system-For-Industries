# Copy this to .env locally, or set these as environment variables on your
# hosting platform (e.g. Render's "Environment" tab). Never commit a real
# .env file with production secrets to git.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-random-key

# Set to False in production. Leave True for local development.
DEBUG=False

# Comma-separated list of hostnames this site will be served from.
# e.g. dkms.onrender.com,www.yourdomain.com
ALLOWED_HOSTS=

# Comma-separated list of full origins (scheme + host) allowed to POST forms.
# Required in production for the login/logout/CSRF-protected forms to work.
# e.g. https://dkms.onrender.com
CSRF_TRUSTED_ORIGINS=

# Postgres connection string. If unset, falls back to local sqlite3.
# Render/Supabase provide this directly.
DATABASE_URL=

# Redis connection string, used for the WebSocket notification channel layer.
# If unset, falls back to an in-memory layer (fine for local dev only —
# it silently breaks notifications once you run more than one worker).
REDIS_URL=
